# Reality Check: copy to .env and fill in. Never commit .env.

# Box custom app (Server Authentication, Client Credentials Grant)
BOX_CLIENT_ID=your_box_client_id
BOX_CLIENT_SECRET=your_box_client_secret
BOX_ENTERPRISE_ID=your_box_enterprise_id

# Numeric folder IDs from the Box URL (app.box.com/folder/<ID>)
BOX_CONTRACTS_FOLDER_ID=0
BOX_EVIDENCE_FOLDER_ID=0
BOX_REPORTS_FOLDER_ID=0

# Amazon Bedrock
AWS_REGION=us-east-1
# Frugal default: Amazon Nova Lite (cheapest model that serves this task well).
# Swap for a stronger model (e.g. us.anthropic.claude-sonnet-4-6) only if needed.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_BEARER_TOKEN_BEDROCK=

# Cost tracker (RealityCheckCostTracker stack). The collector Lambda connects to
# Aurora via IAM database authentication ONLY — there is NO password here and no
# secret is stored anywhere. These are just non-secret connection coordinates,
# set automatically as Lambda env vars by CDK (listed here for local parity).
# DB_HOST=<cluster endpoint from the stack output DbEndpoint>
# DB_PORT=5432
# DB_NAME=postgres
# DB_IAM_USER=cost_collector
